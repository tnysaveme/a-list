NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
ALIST_ALLOWED_EMAIL=you@example.com
# Additional members, separated by commas. Each gets a separate private library.
ALIST_ALLOWED_EMAILS=friend1@example.com,friend2@example.com,friend3@example.com
# Set true after custom SMTP is verified to let others create their own accounts.
ALIST_ALLOW_SIGNUPS=false
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ALIST_KEY_SALT=
SUPABASE_SERVICE_ROLE_KEY=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
ALIST_APP_URL=https://your-app.example.com
# Pause new WTS imports with false; known matches and saved-film refreshes continue.
ALIST_WTS_AUTO_IMPORT=false
