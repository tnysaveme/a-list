{
  "name": "a-list",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test": "node scripts/run-tests.mjs",
    "typecheck": "tsc --noEmit",
    "email:render": "node --import tsx scripts/render-emails.tsx",
    "email:preview": "email dev --dir emails --port 3001",
    "test:scaling": "node tests/scaling-integration.mjs",
    "format": "prettier --write \"{app,components,hooks,lib,tests,scripts,emails,db}/**/*.{ts,tsx,mts,mjs,css}\" \"*.{ts,mjs,css,md,json}\" \".github/workflows/*.{yml,yaml}\"",
    "format:check": "prettier --check \"{app,components,hooks,lib,tests,scripts,emails,db}/**/*.{ts,tsx,mts,mjs,css}\" \"*.{ts,mjs,css,md,json}\" \".github/workflows/*.{yml,yaml}\"",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "sources:check": "node --import tsx scripts/check-sources.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@upstash/qstash": "2.12.1",
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.39.0",
    "lucide-react": "^1.31.0",
    "next": "16.4.3",
    "radix-ui": "^1.6.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "react-email": "6.11.3",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "type": "module"
}
